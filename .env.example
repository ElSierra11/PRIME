# ==========================================
# PRIME OS - Environment Configuration
# ==========================================

# Puerto del servidor Gateway (por defecto 5000)
PORT=5000

# ==========================================
# SUPABASE CONFIGURATION
# Obtén estos valores en supabase.com -> Tu Proyecto -> Settings -> API
# ==========================================

# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Clave pública de Supabase (anon public o service_role)
SUPABASE_KEY=

# ==========================================
# WEB PUSH & VAPID (Opcional - Se autogeneran si están vacíos)
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==========================================
# WHATSAPP NOTIFICATIONS (Opcional - Configurable en la UI)
# ==========================================
# Para Twilio WhatsApp (Opcional):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
